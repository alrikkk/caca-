# ==============================================================================
# Caca - Environment Variables
# ==============================================================================

# Supabase Public API (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Provider Configuration (Optional for Mock provider, required for live LLM extraction)
# Options: 'mock' | 'gemini' | 'openai' | 'anthropic'
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
